{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Компиляция двух файлов C++",
            "command": "g++",
            "args": [
                "-g",
                "pupeler.cpp",
                "second_file.cpp",
                "-o",
                "${fileDirname}\\program.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}